# Native stack: make run-native starts frontend on 3011 and backend on 4040.
QA_BASE_URL=http://localhost:3011
# Optional: enables API health verification. Root backend health is /api/health.
QA_API_URL=http://localhost:4040
# Authenticated projects are opt-in, and read local .auth/*.json files.
# QA_RUN_MERCHANT=1
# QA_RUN_ADMIN=1
# QA_ALL_BROWSERS=1
