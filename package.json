{
  "name": "tajeerai-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Playwright quality assurance suite for Tajeer AI",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:api": "playwright test --project=chromium --grep @api",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:cross-browser": "cross-env QA_ALL_BROWSERS=1 playwright test --grep @smoke",
    "test:merchant": "cross-env QA_RUN_MERCHANT=1 playwright test --project=merchant-chromium",
    "test:admin": "cross-env QA_RUN_ADMIN=1 playwright test --project=admin-chromium",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "codegen": "node scripts/codegen.mjs",
    "auth:merchant": "node scripts/record-auth.mjs merchant",
    "auth:admin": "node scripts/record-auth.mjs admin",
    "browsers:install": "playwright install chromium firefox webkit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.9.0"
  }
}
